---
/**
 * Home (the pillar), ordered for a hurried reader on a phone (brief of 2026-11-09): the question, the answer in one
 * sentence, three questions for a reader who does not know where to start, the calculator already filled in, what to
 * copy from the plan papers, the cited summary, then the disability sections in the order a claim happens. Plan data,
 * cost, long-term care and accident policies are folded under their titles (text kept in the HTML).
 * Text: src/content/home.ts. Generated blocks carry data-chrome.
 */
import PageLayout from '../layouts/PageLayout.astro';
import Clamp from './Clamp.astro';
import Tool from './Tool.astro';
import Body from './Body.astro';
import Fold from './Fold.astro';
import { HOME, VALUE } from '../content/home';
import { route } from '../i18n/routes';
import { GROUPS } from '../i18n/nav';
import { helpers, SOURCES, table } from '../lib/helpers';
import { PAGES } from '../lib/pages';
import { KIT as K } from '../lib/kit';
import { faqSchema, organizationSchema, websiteSchema, webPageSchema, webApplicationSchema } from '../lib/seo';
import { LAST_UPDATED } from '../data/site-config';
const lang = 'en';
const x = HOME;
const path = route('home', lang);
const h = helpers();
const sources = x.sources.map((k) => ({ name: SOURCES[k].label, url: SOURCES[k].url }));
const jsonLd = [websiteSchema(lang), organizationSchema(lang), webPageSchema({ name: x.h1, description: x.description, path, lang }), webApplicationSchema({ name: x.h1, description: x.description, path, lang }), faqSchema(x.faqs, lang)];
const doors = [
  { label: 'My placard expires: do I need a doctor?', href: route('handicap-placard-renewal', lang) },
  { label: 'Recovering from surgery (temporary)', href: route('temporary-handicap-placard', lang) },
  { label: 'Can my nurse practitioner sign?', href: route('who-can-sign-a-handicap-placard-form', lang) },
  { label: 'Driving to or moving to another state', href: route('handicap-placard-in-another-state', lang) },
];
---
<PageLayout title={x.title} description={x.description} lang={lang} jsonLd={jsonLd} faqs={x.faqs} sources={sources} faqOuverte={0}>
  <header class="mb-3">
    <h1 class="font-serif text-[1.75rem] font-bold text-navy-900 max-sm:leading-tight sm:text-3xl md:text-4xl">{x.h1}</h1>
    <p class="mt-2 text-base font-medium text-navy-900 sm:text-lg">{x.answer}</p>
    <p class="mt-2 text-sm font-medium text-navy-700">Independent site, not a DMV: nothing sold, no contact details asked.</p>
  </header>
  <div id="calculator" data-outil data-chrome class="scroll-mt-20"><Tool kind="all" idPrefix="home" /></div>
  <p class="mt-3 text-sm text-navy-600">Official forms of the 50 states and DC · last updated November 13, 2026 · <a href={route('method', lang)} class="underline">How we checked the rules</a> · <a href={route('about', lang)} class="underline">Who publishes this</a></p>
  {/* Doors by profile (brief of 2026-11-10, rule 2), placed right under the checker on this site: the four situations
      readers write in about most, numbered so a phone reader can say "the third one". */}
  <aside data-chrome data-profils aria-label="Start from your question" class="mt-4 rounded-lg border border-navy-200 bg-navy-50/60 p-4">
    <p class="mb-2 text-base font-semibold text-navy-900">Not sure where to start? Pick your situation</p>
    <ol class="grid list-decimal gap-2 pl-5 sm:grid-cols-2">
      {doors.map((d) => <li><a href={d.href} class="font-medium text-accent-700 underline-offset-2 hover:underline">{d.label}</a></li>)}
    </ol>
  </aside>
  <section class="mt-6"><Body html={x.start(h)} path={path} /></section>
  <Clamp text={x.resume} lang={lang} id="clamp-home" class="my-6" />
  <section class="mt-6"><Body html={x.guide(h)} path={path} /></section>
  <div class="mt-8">
    {x.folds.map((f) => <Fold title={f.title} id={f.id}><Body html={f.html(h)} path={path} /></Fold>)}
  </div>
  <section data-chrome class="mt-8 border-t border-navy-200 pt-6" id="calculators">
    <h2 class="font-serif text-xl font-bold text-navy-900">Every guide and every state</h2>
    {GROUPS.map((g) => (
      <article class="mt-4">
        <h3 class="text-sm font-semibold uppercase tracking-wide text-navy-600">{g.label}</h3>
        <p class="mt-1 text-sm leading-relaxed">
          {PAGES.filter((p) => p.group === g.id).map((p, i) => <>{i > 0 && ' · '}<a href={route(p.id, lang)} class="font-medium text-accent-700 underline-offset-2 hover:underline">{p.nav}</a></>)}
        </p>
      </article>
    ))}
  </section>
</PageLayout>
