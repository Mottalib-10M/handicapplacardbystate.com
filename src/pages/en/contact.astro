---
import PageLayout from '../../layouts/PageLayout.astro';
import { route } from '../../i18n/routes';
import { CONTACT_EMAIL } from '../../data/site-config';
import { contactPageSchema } from '../../lib/seo';
const lang = 'en';
const path = route('contact', lang);
const description = 'Write to Handicap Placard By State about a state form, a fee or a renewal rule that changed. E-mail only: no application filed, nothing passed on to anyone.';
---
<PageLayout title="Contact Handicap Placard By State: report a form that changed" description={description} lang={lang} noindex={true} jsonLd={[contactPageSchema({ name: 'Contact', description, path, lang })]} breadcrumbs={[{ label: 'Contact' }]} showAuthor={false}>
  <article class="prose prose-slate max-w-none prose-headings:font-serif">
    <h1>Contact</h1>
    <p>By e-mail: <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>. There is no form and no phone line, and nothing you write is passed on to anyone.</p>
    <h2>What helps us most</h2>
    <ul>
      <li>A new edition of a state form, with its number and revision date.</li>
      <li>A fee, a length or a renewal rule we read wrong: quote the official page or form that says otherwise.</li>
      <li>A “not stated” field you can fill from an official document of your state.</li>
      <li>Embedding the checker on a clinic, senior center or library page: the code is on the <a href={route('widget', lang)}>embed page</a>.</li>
    </ul>
    <h2>What we cannot do</h2>
    <p>We do not file applications, issue placards, certify a disability, or say whether you qualify. Your state’s motor vehicle agency and your medical professional are the ones who can.</p>
  </article>
</PageLayout>
